# Required: random string, at least 32 characters (openssl rand -hex 32)
JWT_SECRET=
# Optional: without it, posts are kept in memory
DATABASE_URL=postgres://postgres:secret@localhost:5432/drizzle?sslmode=disable
# Optional: enables AI image generation
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_QUOTA_PER_HOUR=10
